rules_version = '2';

// Jazba Tickets — who may read and change what in the database.
//
// Orders are the money: a booking or admission pass can only be created by
// an admin, or by the server once Stripe has confirmed the payment (the
// server uses the Firebase service account, which these rules don't apply
// to — see api/_lib/orderRecords.ts). So nobody can give themselves a "paid"
// ticket from their browser. Publish changes from Admin → Dashboard, or with
// `firebase deploy --only firestore:rules`.

service cloud.firestore {
  match /databases/{database}/documents {

    // Anything not listed below is closed.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Helpers ─────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'zahidyaftali999@gmail.com';
    }

    // The caller's role from their profile; a suspended account has none.
    function hasRole(role) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(path)
        && get(path).data.role == role
        && get(path).data.get('status', 'active') != 'suspended';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || hasRole('admin');
    }

    function isOrganizer() {
      return hasRole('organizer');
    }

    function isArtist() {
      return hasRole('artist');
    }

    // Door staff: a login made by an admin for the gate. It can only look
    // tickets up and check people in (Jazba Scan) — nothing else, and only
    // for the events an admin gave it (doorStaff/<uid>.events).
    function isDoorStaff() {
      return hasRole('staff');
    }

    // Organisers can check people in at their own events with Jazba Scan:
    // the server keeps their own doorStaff/<uid> list of events, so they
    // follow exactly the same rules as door staff.
    function isDoorStaffFor(eventId) {
      let path = /databases/$(database)/documents/doorStaff/$(request.auth.uid);
      return (isDoorStaff() || isOrganizer()) && exists(path) && eventId in get(path).data.get('events', []);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'status', 'createdAt'])
        && data.keys().size() <= 10
        && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 128
        && data.name is string && data.name.size() <= 128
        && data.role is string && (data.role == 'admin' || data.role == 'organizer' || data.role == 'artist' || data.role == 'staff' || data.role == 'user')
        && data.status is string && (data.status == 'active' || data.status == 'suspended')
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 32))
        && (!data.keys().hasAny(['profileImage']) || (data.profileImage is string && data.profileImage.size() <= 512))
        && (!data.keys().hasAny(['city']) || (data.city is string && data.city.size() <= 64))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // ── Accounts ────────────────────────────────────────────────────────
    // Profiles hold emails and phone numbers: only the owner and admins see
    // them. People can edit their own profile, but never their own role or
    // suspension.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming())
        && (incoming().role == 'user' || isBootstrappedAdmin())
        && incoming().status == 'active';
      allow update: if isAdmin() || (
        isOwner(userId) && isValidUser(incoming())
        && incoming().role == existing().role
        && incoming().status == existing().status
      );
      allow delete: if isAdmin();
    }

    // ── Public profiles and events ──────────────────────────────────────
    // ── Organisers ──────────────────────────────────────────────────────
    // Anyone signed in may apply: the application is their own
    // organizers/<uid> profile, created as "pending". Only an admin approves,
    // rejects, suspends or features an organiser — and approving also gives
    // the account the organiser role, which is what allows creating events.
    // Profiles made by admins before sign-ups existed have no status and
    // count as approved.
    function isValidOrganizer(data) {
      return data.keys().hasOnly(['id', 'userId', 'companyName', 'contactName', 'email', 'phone', 'logoUrl',
            'bannerUrl', 'description', 'website', 'location', 'specialties', 'socialLinks', 'featured',
            'status', 'applicationNote', 'reviewNote', 'createdAt', 'updatedAt', 'reviewedAt', 'feePercent'])
        && data.userId is string
        && data.companyName is string && data.companyName.size() > 0 && data.companyName.size() <= 120
        && data.get('contactName', '') is string && data.get('contactName', '').size() <= 120
        && data.get('email', '') is string && data.get('email', '').size() <= 254
        && data.get('phone', '') is string && data.get('phone', '').size() <= 40
        && data.get('logoUrl', '') is string && data.get('logoUrl', '').size() <= 1024
        && data.get('bannerUrl', '') is string && data.get('bannerUrl', '').size() <= 1024
        && data.get('description', '') is string && data.get('description', '').size() <= 5000
        && data.get('website', '') is string && data.get('website', '').size() <= 512
        && data.get('location', '') is string && data.get('location', '').size() <= 120
        && data.get('applicationNote', '') is string && data.get('applicationNote', '').size() <= 3000
        && data.get('specialties', []) is list && data.get('specialties', []).size() <= 12
        && data.get('socialLinks', {}) is map && data.get('socialLinks', {}).size() <= 8
        && data.get('status', 'approved') in ['pending', 'approved', 'rejected', 'suspended'];
    }

    // Public profiles: approved ones (old admin-made ones have no status).
    // An application in review, rejected or paused is seen only by its
    // owner and admins. Private details live in organizerPrivate.
    match /organizers/{organizerId} {
      allow get: if resource.data.get('status', 'approved') == 'approved' || isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if resource.data.status == 'approved' || isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(organizerId) && (isAdmin() || (
        isOwner(organizerId) && isValidOrganizer(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().get('featured', false) == false
        && !incoming().keys().hasAny(['reviewNote', 'reviewedAt', 'feePercent'])
      ));
      allow update: if isValidId(organizerId) && (isAdmin() || (
        isSignedIn() && existing().userId == request.auth.uid
        && isValidOrganizer(incoming())
        && incoming().userId == existing().userId
        && existing().get('status', 'approved') != 'suspended'
        && incoming().get('featured', false) == existing().get('featured', false)
        && incoming().get('reviewNote', '') == existing().get('reviewNote', '')
        && incoming().get('reviewedAt', '') == existing().get('reviewedAt', '')
        && incoming().get('feePercent', 0) == existing().get('feePercent', 0)
        && (incoming().get('status', 'approved') == existing().get('status', 'approved')
            || (existing().get('status', '') == 'rejected' && incoming().get('status', '') == 'pending'))
      ));
      allow delete: if isAdmin();
    }

    match /artists/{artistId} {
      allow read: if true;
      allow create: if isValidId(artistId) && (isAdmin() || (isArtist() && incoming().userId == request.auth.uid));
      allow update: if isValidId(artistId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId));
      allow delete: if isAdmin();
    }

    // Organisers manage only their own events, and only an admin can put
    // one on sale: an organiser saves drafts and submits them for review
    // ("pending"); an admin publishes. Organisers can take their own event
    // off sale (back to draft) but never publish, feature or promote it,
    // and can delete it only while it has never been on sale.
    function isValidOrganizerEvent(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.get('type', 'upcoming') == 'upcoming'
        && data.get('featured', false) == false
        && data.get('everPublished', false) == false
        && !data.keys().hasAny(['followersNotifiedAt'])
        && data.get('ticketOptions', []) is list && data.get('ticketOptions', []).size() <= 30;
    }

    match /events/{eventId} {
      // Events on sale are public; drafts and events in review are seen
      // only by their organiser and admins (queries must ask for
      // status == 'published', or for the organiser's own events).
      allow get: if resource.data.get('status', '') == 'published' || isAdmin()
        || (isSignedIn() && resource.data.get('organizerId', '') == request.auth.uid);
      allow list: if resource.data.status == 'published' || isAdmin()
        || (isSignedIn() && resource.data.organizerId == request.auth.uid);
      allow create: if isValidId(eventId) && (isAdmin() || (
        isOrganizer() && incoming().organizerId == request.auth.uid
        && incoming().status in ['draft', 'pending']
        && isValidOrganizerEvent(incoming())
      ));
      allow update: if isValidId(eventId) && (isAdmin() || (
        isOrganizer() && existing().organizerId == request.auth.uid
        && incoming().organizerId == existing().organizerId
        && (incoming().status == existing().status || incoming().status in ['draft', 'pending'])
        && incoming().get('type', 'upcoming') == existing().get('type', 'upcoming')
        && incoming().get('featured', false) == existing().get('featured', false)
        && incoming().get('everPublished', false) == existing().get('everPublished', false)
        && incoming().get('followersNotifiedAt', '') == existing().get('followersNotifiedAt', '')
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 200
        && incoming().get('ticketOptions', []) is list && incoming().get('ticketOptions', []).size() <= 30
      ));
      allow delete: if isAdmin() || (
        isOrganizer() && existing().organizerId == request.auth.uid
        && existing().get('status', 'draft') in ['draft', 'pending']
        && existing().get('everPublished', false) == false
      );
    }

    // ── Orders ──────────────────────────────────────────────────────────
    // Buyers can see their own orders and passes. Only admins (and the
    // server, after a confirmed payment) can create or change them.
    // Door staff may read the orders and passes of their own events (to look
    // a ticket up at the gate) and check people in — see isDoorCheckIn().
    // Their queries must name the event (where eventId == …).
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isDoorStaffFor(resource.data.eventId));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isDoorStaffFor(resource.data.eventId));
      allow create, update: if isValidId(bookingId) && isAdmin();
      allow delete: if isAdmin();
    }

    // A door check-in: more people in on an active pass of a paid, not
    // cancelled order — never fewer, never past what the pass admits, and
    // signed with the staff member's own email. Nothing else on the pass can
    // change. How many a pass admits is fixed at its first check-in.
    function isDoorCheckIn() {
      let before = existing();
      let after = incoming();
      let admits = before.get('people', after.get('people', 0));
      let wasIn = before.get('peopleIn', 0);
      let order = get(/databases/$(database)/documents/bookings/$(before.bookingId)).data;
      return isDoorStaffFor(before.eventId)
        && after.diff(before).affectedKeys().hasOnly(['status', 'people', 'peopleIn', 'scannedAt', 'scannedBy', 'checkIns'])
        && before.status == 'active'
        && admits is int && admits >= 1 && admits <= 20
        && after.get('people', 0) == admits
        // Before its first check-in a pass may claim more than one person
        // only on a group package (e.g. "Standard Group").
        && (before.keys().hasAny(['people']) || admits == 1
            || order.get('tier', '').lower().matches('.*group.*')
            || order.get('tierName', '').lower().matches('.*group.*'))
        && wasIn is int
        && after.peopleIn is int && after.peopleIn > wasIn && after.peopleIn <= admits
        && ((after.peopleIn == admits && after.status == 'scanned') || (after.peopleIn < admits && after.status == 'active'))
        && after.scannedBy == request.auth.token.email
        && after.scannedAt is string && after.scannedAt.size() <= 40
        && after.checkIns is list && after.checkIns.size() <= 100
        && order.get('bookingStatus', 'active') != 'cancelled'
        && (order.get('paymentStatus', '') == 'paid' || order.get('paymentMethod', '') == 'complimentary');
    }

    match /tickets/{ticketId} {
      allow get: if isValidId(ticketId) && isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isDoorStaffFor(resource.data.eventId));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isDoorStaffFor(resource.data.eventId));
      allow create: if isValidId(ticketId) && isAdmin();
      allow update: if isValidId(ticketId) && (isAdmin() || isDoorCheckIn());
      allow delete: if isAdmin();
    }

    // Which events each door staff login may check tickets for. Only admins
    // set it; a staff login can read its own.
    match /doorStaff/{staffId} {
      allow get: if isOwner(staffId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(staffId) && isAdmin()
        && incoming().keys().hasOnly(['uid', 'events', 'updatedAt', 'updatedBy', 'ownerId'])
        && incoming().events is list && incoming().events.size() <= 50;
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isValidId(paymentId) && isAdmin();
      allow delete: if isAdmin();
    }

    // Money paid out to an organiser, recorded by an admin. Organisers can
    // read their own; only admins write.
    match /payouts/{payoutId} {
      allow read: if isSignedIn() && (resource.data.organizerId == request.auth.uid || isAdmin());
      allow create, update: if isValidId(payoutId) && isAdmin();
      allow delete: if isAdmin();
    }

    // ── Organiser private details ───────────────────────────────────────
    // Bank details for payouts, sale-email setting and their application
    // note: only the organiser and admins. The Jazba fee and review notes
    // are set by admins only.
    function isValidOrganizerPrivate(data) {
      return data.keys().hasOnly(['payout', 'notifyOnSale', 'applicationNote', 'feePercent', 'reviewNote', 'updatedAt'])
        && data.get('payout', {}) is map && data.get('payout', {}).size() <= 12
        && data.get('notifyOnSale', true) is bool
        && data.get('applicationNote', '') is string && data.get('applicationNote', '').size() <= 3000
        && data.get('updatedAt', '') is string && data.get('updatedAt', '').size() <= 64;
    }

    match /organizerPrivate/{organizerId} {
      allow get: if isAdmin() || isOwner(organizerId);
      allow list: if isAdmin();
      allow create: if isValidId(organizerId) && (isAdmin() || (
        isOwner(organizerId) && isValidOrganizerPrivate(incoming())
        && !incoming().keys().hasAny(['feePercent', 'reviewNote'])
      ));
      allow update: if isValidId(organizerId) && (isAdmin() || (
        isOwner(organizerId) && isValidOrganizerPrivate(incoming())
        && incoming().get('feePercent', -1) == existing().get('feePercent', -1)
        && incoming().get('reviewNote', '') == existing().get('reviewNote', '')
      ));
      allow delete: if isAdmin();
    }

    // ── Discount codes ──────────────────────────────────────────────────
    // An organiser's own codes: only they and admins can see or change
    // them. How many times a code was used is counted by the server. The
    // payment server checks a code works on that organiser's events only.
    function isValidPromo(data, code) {
      return data.keys().hasOnly(['code', 'organizerId', 'eventIds', 'tiers', 'percentOff', 'maxUses', 'uses',
            'startsAt', 'endsAt', 'active', 'label', 'createdAt', 'updatedAt'])
        && code.matches('^[A-Z0-9]{3,24}$') && data.code == code
        && data.organizerId is string && data.organizerId.size() > 0 && data.organizerId.size() <= 128
        && data.eventIds is list && data.eventIds.size() <= 30
        && data.tiers is list && data.tiers.size() <= 30
        && data.percentOff is int && data.percentOff >= 1 && data.percentOff <= 100
        && data.maxUses is int && data.maxUses >= 0 && data.maxUses <= 100000
        && data.uses is int && data.uses >= 0
        && data.startsAt is string && data.startsAt.size() <= 40
        && data.endsAt is string && data.endsAt.size() <= 40
        && data.active is bool
        && data.get('label', '') is string && data.get('label', '').size() <= 80;
    }

    match /promoCodes/{code} {
      allow get, list: if isSignedIn() && (isAdmin() || resource.data.organizerId == request.auth.uid);
      allow create: if isValidPromo(incoming(), code) && (isAdmin() || (
        isOrganizer() && incoming().organizerId == request.auth.uid && incoming().uses == 0
      ));
      allow update: if isValidPromo(incoming(), code) && (isAdmin() || (
        isOrganizer() && existing().organizerId == request.auth.uid
        && incoming().organizerId == existing().organizerId
        && incoming().uses == existing().uses
      ));
      allow delete: if isAdmin() || (isOrganizer() && existing().organizerId == request.auth.uid);
    }

    // ── Waitlists ───────────────────────────────────────────────────────
    // Anyone can put their name down for a sold-out event (one entry per
    // email per event: the entry id is eventId__email). Only admins read
    // them here; organisers see their own events' lists through the server.
    match /waitlist/{entryId} {
      allow create: if isValidId(entryId)
        && incoming().keys().hasOnly(['eventId', 'name', 'email', 'tier', 'userId', 'createdAt', 'status'])
        && incoming().eventId is string && isValidId(incoming().eventId)
        && entryId.matches('^' + incoming().eventId + '__[a-z0-9_-]{3,100}$')
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() <= 200
        && incoming().email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && incoming().get('tier', '') is string && incoming().get('tier', '').size() <= 64
        && (incoming().get('userId', '') == '' || (isSignedIn() && incoming().userId == request.auth.uid))
        && incoming().createdAt is string && incoming().createdAt.size() <= 40
        && incoming().status == 'waiting'
        && exists(/databases/$(database)/documents/events/$(incoming().eventId));
      allow read, update, delete: if isAdmin();
    }

    // ── Notifications ───────────────────────────────────────────────────
    // People can only mark their own notifications read.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid);
      allow update: if isAdmin() || (
        isSignedIn() && existing().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
      );
      allow delete: if isAdmin();
    }

    match /analytics/{analyticsDocId} {
      allow read, write: if isAdmin();
    }

    // ── Follows ─────────────────────────────────────────────────────────
    function isValidFollow(data, followId) {
      return data.keys().hasAll(['followerId', 'targetType', 'targetId', 'createdAt'])
        && data.keys().size() == 4
        && data.followerId is string && data.followerId == request.auth.uid
        && data.targetType is string && (data.targetType == 'artist' || data.targetType == 'organizer')
        && data.targetId is string && data.targetId.size() <= 128
        && data.createdAt is string && data.createdAt.size() <= 64
        && followId == data.followerId + '_' + data.targetType + '_' + data.targetId;
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(followId) && isValidFollow(incoming(), followId);
      allow delete: if isSignedIn() && (existing().followerId == request.auth.uid || isAdmin());
      allow update: if false;
    }
  }
}
