rules_version = '2';

// Jazba Tickets — who may read and change what in the database.
//
// Orders are the money: a booking or admission pass can only be created by
// an admin, or by the server once Stripe has confirmed the payment (the
// server uses the Firebase service account, which these rules don't apply
// to — see api/_lib/orderRecords.ts). So nobody can give themselves a "paid"
// ticket from their browser. Publish changes from Admin → Dashboard, or with
// `firebase deploy --only firestore:rules`.

service cloud.firestore {
  match /databases/{database}/documents {

    // Anything not listed below is closed.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Helpers ─────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'zahidyaftali999@gmail.com';
    }

    // The caller's role from their profile; a suspended account has none.
    function hasRole(role) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(path)
        && get(path).data.role == role
        && get(path).data.get('status', 'active') != 'suspended';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || hasRole('admin');
    }

    function isOrganizer() {
      return hasRole('organizer');
    }

    function isArtist() {
      return hasRole('artist');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'status', 'createdAt'])
        && data.keys().size() <= 10
        && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 128
        && data.name is string && data.name.size() <= 128
        && data.role is string && (data.role == 'admin' || data.role == 'organizer' || data.role == 'artist' || data.role == 'user')
        && data.status is string && (data.status == 'active' || data.status == 'suspended')
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 32))
        && (!data.keys().hasAny(['profileImage']) || (data.profileImage is string && data.profileImage.size() <= 512))
        && (!data.keys().hasAny(['city']) || (data.city is string && data.city.size() <= 64))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // ── Accounts ────────────────────────────────────────────────────────
    // Profiles hold emails and phone numbers: only the owner and admins see
    // them. People can edit their own profile, but never their own role or
    // suspension.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming())
        && (incoming().role == 'user' || isBootstrappedAdmin())
        && incoming().status == 'active';
      allow update: if isAdmin() || (
        isOwner(userId) && isValidUser(incoming())
        && incoming().role == existing().role
        && incoming().status == existing().status
      );
      allow delete: if isAdmin();
    }

    // ── Public profiles and events ──────────────────────────────────────
    // ── Organisers ──────────────────────────────────────────────────────
    // Anyone signed in may apply: the application is their own
    // organizers/<uid> profile, created as "pending". Only an admin approves,
    // rejects, suspends or features an organiser — and approving also gives
    // the account the organiser role, which is what allows creating events.
    // Profiles made by admins before sign-ups existed have no status and
    // count as approved.
    function isValidOrganizer(data) {
      return data.keys().hasOnly(['id', 'userId', 'companyName', 'contactName', 'email', 'phone', 'logoUrl',
            'bannerUrl', 'description', 'website', 'location', 'specialties', 'socialLinks', 'featured',
            'status', 'applicationNote', 'reviewNote', 'createdAt', 'updatedAt', 'reviewedAt'])
        && data.userId is string
        && data.companyName is string && data.companyName.size() > 0 && data.companyName.size() <= 120
        && data.get('contactName', '') is string && data.get('contactName', '').size() <= 120
        && data.get('email', '') is string && data.get('email', '').size() <= 254
        && data.get('phone', '') is string && data.get('phone', '').size() <= 40
        && data.get('logoUrl', '') is string && data.get('logoUrl', '').size() <= 1024
        && data.get('bannerUrl', '') is string && data.get('bannerUrl', '').size() <= 1024
        && data.get('description', '') is string && data.get('description', '').size() <= 5000
        && data.get('website', '') is string && data.get('website', '').size() <= 512
        && data.get('location', '') is string && data.get('location', '').size() <= 120
        && data.get('applicationNote', '') is string && data.get('applicationNote', '').size() <= 3000
        && data.get('specialties', []) is list && data.get('specialties', []).size() <= 12
        && data.get('socialLinks', {}) is map && data.get('socialLinks', {}).size() <= 8
        && data.get('status', 'approved') in ['pending', 'approved', 'rejected', 'suspended'];
    }

    match /organizers/{organizerId} {
      allow read: if true;
      allow create: if isValidId(organizerId) && (isAdmin() || (
        isOwner(organizerId) && isValidOrganizer(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().get('featured', false) == false
        && !incoming().keys().hasAny(['reviewNote', 'reviewedAt'])
      ));
      allow update: if isValidId(organizerId) && (isAdmin() || (
        isSignedIn() && existing().userId == request.auth.uid
        && isValidOrganizer(incoming())
        && incoming().userId == existing().userId
        && existing().get('status', 'approved') != 'suspended'
        && incoming().get('featured', false) == existing().get('featured', false)
        && incoming().get('reviewNote', '') == existing().get('reviewNote', '')
        && incoming().get('reviewedAt', '') == existing().get('reviewedAt', '')
        && (incoming().get('status', 'approved') == existing().get('status', 'approved')
            || (existing().get('status', '') == 'rejected' && incoming().get('status', '') == 'pending'))
      ));
      allow delete: if isAdmin();
    }

    match /artists/{artistId} {
      allow read: if true;
      allow create: if isValidId(artistId) && (isAdmin() || (isArtist() && incoming().userId == request.auth.uid));
      allow update: if isValidId(artistId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId));
      allow delete: if isAdmin();
    }

    // Organisers manage only their own events, and only an admin can put
    // one on sale: an organiser saves drafts and submits them for review
    // ("pending"); an admin publishes. Organisers can take their own event
    // off sale (back to draft) but never publish, feature or promote it,
    // and can delete it only while it has never been on sale.
    function isValidOrganizerEvent(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.get('type', 'upcoming') == 'upcoming'
        && data.get('featured', false) == false
        && data.get('everPublished', false) == false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isValidId(eventId) && (isAdmin() || (
        isOrganizer() && incoming().organizerId == request.auth.uid
        && incoming().status in ['draft', 'pending']
        && isValidOrganizerEvent(incoming())
      ));
      allow update: if isValidId(eventId) && (isAdmin() || (
        isOrganizer() && existing().organizerId == request.auth.uid
        && incoming().organizerId == existing().organizerId
        && (incoming().status == existing().status || incoming().status in ['draft', 'pending'])
        && incoming().get('type', 'upcoming') == existing().get('type', 'upcoming')
        && incoming().get('featured', false) == existing().get('featured', false)
        && incoming().get('everPublished', false) == existing().get('everPublished', false)
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 200
      ));
      allow delete: if isAdmin() || (
        isOrganizer() && existing().organizerId == request.auth.uid
        && existing().get('status', 'draft') in ['draft', 'pending']
        && existing().get('everPublished', false) == false
      );
    }

    // ── Orders ──────────────────────────────────────────────────────────
    // Buyers can see their own orders and passes. Only admins (and the
    // server, after a confirmed payment) can create or change them.
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isValidId(bookingId) && isAdmin();
      allow delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow get: if isValidId(ticketId) && isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isValidId(ticketId) && isAdmin();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isValidId(paymentId) && isAdmin();
      allow delete: if isAdmin();
    }

    // ── Notifications ───────────────────────────────────────────────────
    // People can only mark their own notifications read.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid);
      allow update: if isAdmin() || (
        isSignedIn() && existing().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
      );
      allow delete: if isAdmin();
    }

    match /analytics/{analyticsDocId} {
      allow read, write: if isAdmin();
    }

    // ── Follows ─────────────────────────────────────────────────────────
    function isValidFollow(data, followId) {
      return data.keys().hasAll(['followerId', 'targetType', 'targetId', 'createdAt'])
        && data.keys().size() == 4
        && data.followerId is string && data.followerId == request.auth.uid
        && data.targetType is string && (data.targetType == 'artist' || data.targetType == 'organizer')
        && data.targetId is string && data.targetId.size() <= 128
        && data.createdAt is string && data.createdAt.size() <= 64
        && followId == data.followerId + '_' + data.targetType + '_' + data.targetId;
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(followId) && isValidFollow(incoming(), followId);
      allow delete: if isSignedIn() && (existing().followerId == request.auth.uid || isAdmin());
      allow update: if false;
    }
  }
}
